# Leave Supabase vars empty to run in local mode (embedded Postgres via PGlite).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase transaction pooler, e.g. postgresql://postgres.<ref>:<pw>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Leave Razorpay vars empty to use MockPaymentProvider.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Signs local-mode sessions and magic links. Random per boot when unset.
AUTH_SECRET=
# Comma-separated emails granted the admin role on sign-up.
ADMIN_EMAILS=admin@pitchlab.test
# Bearer token for /api/cron/release-holds.
CRON_SECRET=
# Local PGlite data dir ("memory" for an ephemeral DB). Default .data/pglite
LOCAL_DB_DIR=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
